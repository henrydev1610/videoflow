{
  "name": "videoflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=22.18.0 <25"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @videoflow/shared && npm run build --workspace @videoflow/api && npm run build --workspace @videoflow/media-worker && npm run build --workspace @videoflow/web",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspace @videoflow/web",
    "lint": "eslint apps packages workers tests",
    "format": "prettier --write apps packages workers tests *.json *.mjs *.ts",
    "format:check": "prettier --check apps packages workers tests *.json *.mjs *.ts",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
