{
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "apps/**/*.ts",
    "workers/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "prisma.config.ts"
  ],
  "exclude": ["**/dist", "node_modules"]
}
