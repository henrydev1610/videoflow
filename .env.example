# Overrides opcionais. Defaults de desenvolvimento, nunca segredos de produção.
HTTP_PORT=8080
ORIGIN=http://localhost:8080
POSTGRES_USER=videoflow
POSTGRES_PASSWORD=videoflow-local-only
POSTGRES_DB=videoflow
# Hosts públicos exatos separados por vírgula. Não libera IPs privados.
SOURCE_ALLOWLIST=
# DATABASE_URL/REDIS_URL/ARTIFACT_ROOT são montados internamente pelo Compose.
# TRUSTED_PROXY_HOST é restrito ao serviço videoflow-proxy e resolvido via DNS interno.
# Limites de mídia/retencão não são overrides livres: ver packages/shared/src/index.ts.
# Nunca usar estas credenciais locais numa VPS; escape caracteres reservados de URL.
